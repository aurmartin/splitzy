{
  "name": "splitzy",
  "main": "expo-router/entry",
  "version": "0.4.0",
  "scripts": {
    "start": "EXPO_NO_DOTENV=1 expo start --scheme splitzy-dev",
    "android": "EXPO_NO_DOTENV=1 expo run:android",
    "ios": "EXPO_NO_DOTENV=1 expo run:ios",
    "web": "EXPO_NO_DOTENV=1 expo start --web",
    "test": "NODE_ENV=test dotenv -e .env.test -- jest",
    "test:watch": "NODE_ENV=test dotenv -e .env.test -- jest --watchAll",
    "test:ci": "NODE_ENV=test dotenv -e .env.test -- jest --ci --coverage",
    "format": "prettier --write .",
    "lint": "expo lint",
    "build:android-dev": "EXPO_NO_DOTENV=1 APP_ENV=development dotenv -e .env.development -- eas build --platform android --profile development --local",
    "build:ios-dev": "EXPO_NO_DOTENV=1 APP_ENV=development sh -c 'expo prebuild --platform ios --clean && expo run:ios --device'",
    "build:android-preview": "EXPO_NO_DOTENV=1 APP_ENV=preview dotenv -e .env.preview -- eas build --platform android --profile preview --local --output splitzy-preview.apk",
    "build:android-production": "EXPO_NO_DOTENV=1 APP_ENV=production dotenv -e .env.production -- eas build --platform android --profile production --local --output splitzy.apk",
    "build:ios-preview": "SENTRY_DISABLE_AUTO_UPLOAD=true EXPO_NO_DOTENV=1 APP_ENV=preview sh -c 'expo prebuild --platform ios --clean && expo run:ios --configuration Release --device'",
    "build:ios-production": "SENTRY_DISABLE_AUTO_UPLOAD=true EXPO_NO_DOTENV=1 APP_ENV=production sh -c 'expo prebuild --platform ios --clean && expo run:ios --configuration Release --device'"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "~2.118.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "^58.0.15",
    "expo-status-bar": "~58.0.4",
    "immer": "^10.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-mmkv": "^3.2.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "~26.6.6",
    "@types/react": "~19.3.0",
    "better-sqlite3": "~13.0.3",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.26.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.5.3",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "drizzle-orm",
          "immer"
        ]
      }
    }
  },
  "pnpm": {
    "overrides": {
      "react-is": "19.1.0"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "msw"
    ]
  },
  "volta": {
    "node": "26.13.0"
  }
}
